global:
  resolve_timeout: 5m

route:
  receiver: {{ 'telegram' if telegram_enabled else 'discard' }}
  group_by: [alertname, instance]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 2h

receivers:
  - name: discard
{% if telegram_enabled %}
  - name: telegram
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: "{{ telegram_chat_id }}"
        parse_mode: HTML
        message: "{{ '{{' }} range .Alerts {{ '}}' }}<b>{{ '{{' }} .Labels.alertname {{ '}}' }}</b>: {{ '{{' }} .Annotations.summary {{ '}}' }}{{ '{{' }} end {{ '}}' }}"
{% endif %}
