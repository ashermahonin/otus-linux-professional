global
  log /dev/log local0

defaults
  mode tcp
  timeout connect 5s
  timeout client 30s
  timeout server 30s

frontend mariadb_frontend
  bind 127.0.0.1:3306
  default_backend galera_nodes

backend galera_nodes
  option tcp-check
{% for node in galera_nodes %}
  server db{{ loop.index }} {{ node }}:3306 check inter 2s fall 2 rise 2
{% endfor %}
