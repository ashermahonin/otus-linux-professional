upstream wordpress_nodes {
    server 10.10.10.21:80 max_fails=2 fail_timeout=5s;
    server 10.10.10.22:80 max_fails=2 fail_timeout=5s;
}

server {
    listen 443 ssl;
    server_name {{ web_domain }};

    ssl_certificate /etc/nginx/tls/web.crt;
    ssl_certificate_key /etc/nginx/tls/web.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://wordpress_nodes;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
