*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p tcp -s 10.0.2.0/24 --dport 22 -j ACCEPT
-A INPUT -p tcp -s 192.168.56.0/24 --dport 22 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT
-A INPUT -p tcp -s {{ monitor_ip }} --dport 9100 -j ACCEPT
-A INPUT -p 112 -s {{ '192.168.56.12' if inventory_hostname == 'edge1' else '192.168.56.11' }} -j ACCEPT
COMMIT
