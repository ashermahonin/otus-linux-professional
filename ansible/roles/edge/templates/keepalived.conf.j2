global_defs {
    router_id {{ inventory_hostname }}
}

vrrp_instance WEB_VIP {
    state {{ 'MASTER' if inventory_hostname == 'edge1' else 'BACKUP' }}
    interface {{ external_interface }}
    virtual_router_id 51
    priority {{ '120' if inventory_hostname == 'edge1' else '100' }}
    advert_int 1

    unicast_src_ip {{ '192.168.56.11' if inventory_hostname == 'edge1' else '192.168.56.12' }}
    unicast_peer {
        {{ '192.168.56.12' if inventory_hostname == 'edge1' else '192.168.56.11' }}
    }

    authentication {
        auth_type PASS
        auth_pass otusweb
    }

    virtual_ipaddress {
        {{ dmz_vip }}/24 dev {{ external_interface }}
    }
}
